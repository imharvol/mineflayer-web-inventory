{
  "name": "mineflayer-web-inventory",
  "version": "2.2.0",
  "description": "Web based viewer for your mineflayer bot's inventory",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/compat.d.mts",
        "default": "./dist/compat.mjs"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client/dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsdown",
    "build:client": "npm --prefix client run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "vitest run --project unit --project integration",
    "test:compat": "npm run build && vitest run --project compat",
    "test:e2e": "vitest run --project e2e",
    "test:browser": "playwright test -c test/browser/playwright.config.ts",
    "test:browser:headed": "playwright test -c test/browser/playwright.config.ts --headed",
    "check:package": "tsdown --publint --attw",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "clean": "rm -rf dist client/dist test/server test/browser/test-results test/browser/playwright-report"
  },
  "author": "imharvol <imharvol@gmail.com> (https://imharvol.com/)",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "lodash.debounce": "^4.0.8",
    "minecraft-assets": "^1.19.0",
    "minecraft-data": "^3.117.0",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "minecraft-wrap": "^1.10.0",
    "mineflayer": "^4.39.0",
    "prismarine-item": "^1.16.0",
    "publint": "^0.3.25",
    "socket.io-client": "^4.8.4",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imharvol/mineflayer-web-inventory.git"
  },
  "sideEffects": false,
  "keywords": [
    "mineflayer",
    "minecraft"
  ]
}
