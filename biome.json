{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!test/server",
      "!versions",
      "!**/test-results",
      "!**/playwright-report",
      "!test/fixtures/*.json",
      "!test/fixtures/assets",
      "!client/public/windows/coordinates.json",
      "!**/package-lock.json",
      "!**/*.svelte"
    ]
  },
  "formatter": {
    "lineWidth": 100,
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/logger.ts",
        "test/browser/harness.ts",
        "test/fixtures/capture.ts",
        "test/compat/fixtures/**",
        "example.mjs"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
